# Copy to .env.local and fill in. Never commit real values.

# Public (sent to the browser)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server only. Optional: features stay off until these are set.
# Email sending (booking emails) needs all three of these:
SUPABASE_SECRET_KEY=
RESEND_API_KEY=
EMAIL_FROM="DopeBooking <bookings@your-domain.com>"
# Protects /api/cron/email (Vercel Cron sends it automatically). 16+ chars.
CRON_SECRET=

# Added in later phases
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# SENTRY_DSN=
